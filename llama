#!/usr/bin/env python3
"""Launch llama.cpp server profiles defined in a TOML file."""

from __future__ import annotations

import argparse
import os
import shlex
import sys
import tomllib
from pathlib import Path
from typing import Any

DEFAULT_CONFIG = Path("~/.config/llama-profile-launcher/models.toml").expanduser()


class ConfigError(RuntimeError):
    pass


def expand_path(value: str) -> str:
    return os.path.expandvars(os.path.expanduser(value))


def load_config(path: Path) -> dict[str, Any]:
    try:
        with path.open("rb") as fh:
            config = tomllib.load(fh)
    except FileNotFoundError as exc:
        raise ConfigError(f"config not found: {path}") from exc
    except tomllib.TOMLDecodeError as exc:
        raise ConfigError(f"invalid TOML in {path}: {exc}") from exc

    if not isinstance(config.get("binaries"), dict):
        raise ConfigError("missing [binaries] table")
    if not isinstance(config.get("models"), dict) or not config["models"]:
        raise ConfigError("missing or empty [models] table")
    return config


def merge_args(*sources: dict[str, Any] | None) -> dict[str, Any]:
    merged: dict[str, Any] = {}
    for source in sources:
        if source:
            merged.update(source)
    return merged


def append_flag_args(command: list[str], args: dict[str, Any]) -> None:
    for flag, value in args.items():
        if not flag.startswith("-"):
            raise ConfigError(f"argument key must be a flag, got {flag!r}")

        if value is False or value is None:
            continue
        if value is True:
            command.append(flag)
            continue

        if isinstance(value, list):
            for item in value:
                command.extend((flag, str(item)))
            continue

        command.extend((flag, str(value)))


def model_command(config: dict[str, Any], name: str) -> list[str]:
    models = config["models"]
    if name not in models:
        choices = ", ".join(sorted(models))
        raise ConfigError(f"unknown model {name!r}; available: {choices}")

    model = models[name]
    if not isinstance(model, dict):
        raise ConfigError(f"model {name!r} must be a table")

    binary_key = model.get("binary")
    try:
        binary = expand_path(config["binaries"][binary_key])
    except (KeyError, TypeError) as exc:
        raise ConfigError(f"model {name!r} references unknown binary {binary_key!r}") from exc

    model_path = model.get("model")
    if not isinstance(model_path, str):
        raise ConfigError(f"model {name!r} is missing a model path")

    defaults = config.get("defaults", {}).get("args", {})
    profile_args: dict[str, Any] = {}
    profile_name = model.get("profile")
    if profile_name:
        try:
            profile_args = config["profiles"][profile_name].get("args", {})
        except (KeyError, TypeError) as exc:
            raise ConfigError(
                f"model {name!r} references unknown profile {profile_name!r}"
            ) from exc

    model_args = model.get("args", {})
    args = merge_args(defaults, profile_args, model_args)

    command = [binary, "-m", expand_path(model_path)]

    draft_model = model.get("draft_model")
    if draft_model:
        command.extend(("-md", expand_path(draft_model)))

    server_alias = model.get("server_alias")
    if server_alias:
        command.extend(("--alias", str(server_alias)))

    append_flag_args(command, args)
    return command


def print_model(config: dict[str, Any], name: str) -> None:
    command = model_command(config, name)
    print(shlex.join(command))


def parse_cli(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="llama",
        description="Launch llama.cpp server profiles from TOML.",
    )
    parser.add_argument(
        "--config",
        type=Path,
        default=Path(os.environ.get("LLAMA_PROFILE_CONFIG", DEFAULT_CONFIG)).expanduser(),
        help="config path (default: %(default)s; env: LLAMA_PROFILE_CONFIG)",
    )
    parser.add_argument("--list", action="store_true", help="list configured model names")
    parser.add_argument(
        "--show",
        metavar="MODEL",
        help="print the resolved llama-server command without running it",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the command instead of replacing this process",
    )
    parser.add_argument("model", nargs="?", help="model profile to launch")
    parser.add_argument(
        "extra",
        nargs=argparse.REMAINDER,
        help="extra llama-server arguments appended after configured arguments",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    ns = parse_cli(sys.argv[1:] if argv is None else argv)

    try:
        config = load_config(ns.config)

        if ns.list:
            for name in sorted(config["models"]):
                print(name)
            return 0

        if ns.show:
            print_model(config, ns.show)
            return 0

        if not ns.model:
            raise ConfigError("MODEL is required (or use --list / --show MODEL)")

        command = model_command(config, ns.model)
        command.extend(ns.extra)

        if ns.dry_run:
            print(shlex.join(command))
            return 0

        binary = command[0]
        os.execv(binary, command)
        return 0

    except ConfigError as exc:
        print(f"llama: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
