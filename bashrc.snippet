# llama-profile-launcher
# Ensure ~/.local/bin is on PATH.
export PATH="$HOME/.local/bin:$PATH"

# Optional short aliases for frequently used profiles.
alias lq27='llama qwen-27b-120k'
alias lq4='llama qwen-flash-q4-128k'
alias lq3='llama qwen-flash-q3-96k'
alias lq3-128='llama qwen-flash-q3-128k'
alias lgsq='llama qwen-flash-gsq-rco-iq3-128k'
