        "--n-predict": 32768
      }
    },
    "qwen-flash-gsq-rco-iq3-mtp-128k": {
      "binary": "qwen38",
      "profiles": ["qwen-base", "flash-attn", "flash-next", "mtp", "no-kv-unified"],
      "model": "~/models/Qwen3.8-Flash-Next-GSQ-RCO-GGUF/IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
      "draft_model": "/home/chris/models/Qwen3.8-Flash-Next-GSQ-RCO-GGUF/MTP/mtp-Qwen3.8-Flash-Next-shared-Q4_K_M.gguf",
