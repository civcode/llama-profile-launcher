{
  "binaries": {
    "native": "/home/chris/workspace/llama.cpp/build-native/bin/llama-server",
    "qwen38": "/home/chris/workspace/llama.cpp-qwen38-mtp/build/bin/llama-server"
  },
  "defaults": {
    "args": {
      "--host": "127.0.0.1",
      "--port": 8080
    }
  },
  "profiles": {
    "qwen-base": {
      "args": {
        "--parallel": 1,
        "--jinja": true,
        "--temp": 1,
        "--top-p": 0.95,
        "--top-k": 20,
        "--min-p": 0,
        "--reasoning-format": "auto",
        "--reasoning": "auto",
        "--reasoning-budget": -1
      }
    },
    "flash-attn": {
      "args": {
        "--flash-attn": "on"
      }
    },
    "mtp": {
      "args": {
        "--spec-type": "draft-mtp",
        "--spec-draft-n-max": 3
      }
    },
    "flash-next": {
      "args": {
        "--load-mode": "mmap",
        "--lazy-mode": "on"
      }
    },
    "no-kv-unified": {
      "args": {
        "--no-kv-unified": true
      }
    }
  },
  "models": {
    "qwen-27b-120k": {
      "binary": "qwen38",
      "profiles": ["qwen-base", "flash-attn", "mtp"],
      "model": "~/models/Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf",
      "server_alias": "qwen3.8-27b-gsq-rco-iq3_s-120k",
      "args": {
        "--n-gpu-layers": "all",
        "--fit": "on",
        "--fit-target": 256,
        "--ctx-size": 122880,
        "--cache-type-k": "q4_0",
        "--cache-type-v": "q4_0",
        "--n-predict": 32768
      }
    },
    "qwen-27b-64k": {
      "binary": "qwen38",
      "profiles": ["qwen-base", "flash-attn", "mtp"],
      "model": "~/models/Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf",
      "server_alias": "qwen3.8-27b-gsq-rco-iq3_s-64k",
      "args": {
        "--n-gpu-layers": "auto",
        "--fit": "on",
        "--fit-target": 256,
        "--ctx-size": 64768,
        "--cache-type-k": "q8_0",
        "--cache-type-v": "q8_0",
        "--n-predict": 32768
      }
    },
    "qwen-flash-gsq-rco-iq3-128k": {
      "binary": "qwen38",
      "profiles": ["qwen-base", "flash-attn", "flash-next"],
      "model": "~/models/Qwen3.8-Flash-Next-GSQ-RCO-GGUF/IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
      "server_alias": "qwen3.8-flash-next-gsq-rco-iq3_xxs-128k",
      "args": {
        "--fit-target": 256,
        "--ctx-size": 131072,
        "--n-predict": 32768,
        "--batch-size": 4096,
        "--ubatch-size": 2048
