    },
    "qwen-flash-gsq-rco-iq3-256k": {
      "binary": "qwen38",
      "profiles": ["qwen-base", "flash-attn", "flash-next", "no-kv-unified"],
      "model": "~/models/Qwen3.8-Flash-Next-GSQ-RCO-GGUF/IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
      "server_alias": "qwen3.8-flash-next-gsq-rco-iq3_xxs-256k",
      "args": {
        "--fit-target": 256,
        "--ctx-size": 262144,
        "--n-predict": 32768
      }
