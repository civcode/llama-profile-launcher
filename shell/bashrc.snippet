# llama-profile-launcher
# Ensure ~/.local/bin is on PATH.
export PATH="$HOME/.local/bin:$PATH"

# Optional short aliases for this workstation.
alias lq27='llama qwen-27b-120k'
alias lq27-64='llama qwen-27b-64k'
alias lqf128='llama qwen-flash-gsq-rco-iq3-128k'
alias lqf256='llama qwen-flash-gsq-rco-iq3-256k'
alias lq35='llama qwen-3.5-4b-240k'
alias lqfmtp='llama qwen-flash-gsq-rco-iq3-mtp-128k'
