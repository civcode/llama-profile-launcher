# Bash completion for llama-profile-launcher.

_llama_profile_launcher_complete() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    case "$prev" in
        --config)
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
            return
            ;;
        --show)
            mapfile -t COMPREPLY < <(compgen -W "$(llama --list 2>/dev/null)" -- "$cur")
            return
            ;;
        --show-router|--export-router|--router)
            mapfile -t COMPREPLY < <(compgen -W "$(llama --list-routers 2>/dev/null)" -- "$cur")
            return
            ;;
    esac

    if [[ $COMP_CWORD -eq 1 ]]; then
        mapfile -t COMPREPLY < <(
            compgen -W "--config --list --show --list-routers --show-router --export-router --router --dry-run --one-line $(llama --list 2>/dev/null)" -- "$cur"
        )
    fi
}

complete -F _llama_profile_launcher_complete llama
